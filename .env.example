ALPHALENS_MODE=beta
# SEC requires an application identity and monitored contact email.
SEC_USER_AGENT=AlphaLens/0.4 operations@example.com
IR_USER_AGENT=AlphaLens/0.4 operations@example.com

# BYO licensed data. Do not enable with a free/personal key for commercial use.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_LICENSE_ACK=

# Long random secret used only by the scheduled/internal queue runner.
WORKER_SHARED_SECRET=
CONNECTOR_ENCRYPTION_KEY=

# Optional notification adapters. Use a verified sender domain and authorized accounts only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WECHAT_OFFICIAL_SEND_URL=
WECHAT_OFFICIAL_ACCESS_TOKEN=

RESEARCH_MODEL_VERSION=deterministic-beta-0.4
RESEARCH_PROMPT_VERSION=equity-research-v1
