{
  "name": "alphalens-investment-os",
  "version": "0.5.0-beta",
  "private": true,
  "description": "An evidence-first, open-source US equity research workbench. Experimental beta; no automated trading.",
  "license": "MIT",
  "author": "axlezhao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axlezhao/AlphaLens.git"
  },
  "bugs": {
    "url": "https://github.com/axlezhao/AlphaLens/issues"
  },
  "homepage": "https://github.com/axlezhao/AlphaLens#readme",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:local": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=wrangler.local.jsonc WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run test:unit && pnpm run build && node --experimental-loader ./tests/cloudflare-loader.mjs --test tests/rendered-html.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:local:migrate": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply DB --local --config wrangler.local.jsonc --persist-to .wrangler/state",
    "db:local:verify-integrity": "bash scripts/local/verify-tenant-integrity.sh",
    "local:verify": "node --experimental-strip-types scripts/local/verify-fixture.ts",
    "local:verify:e2e": "bash scripts/local/verify-e2e.sh"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
